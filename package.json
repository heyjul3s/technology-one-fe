{
  "name": "technology-one-fe",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "browserlist": "browserslist",
    "browserslist:lint": "browserslist-lint",
    "build": "tsc && vite build",
    "lint": "pnpm run lint:css && pnpm run lint:es && pnpm run lint:markup && pnpm run lint:prettier && pnpm run lint:types",
    "lint:fix": "pnpm run lint:css-fix && pnpm run lint:es-fix && pnpm run lint:markup-fix && pnpm run lint:prettier-fix",
    "lint:css": "stylelint src/**/*.{module.css,css}",
    "lint:css-fix": "stylelint src/**/*.{module.css,css} --fix",
    "lint:es": "oxlint ./src s --deny-warnings",
    "lint:es-fix": "oxlint ./src --deny-warnings --fix",
    "lint:markup": "markuplint src/**/*.{html,jsx,tsx}",
    "lint:markup-fix": "markuplint src/**/*.{html,jsx,tsx} --fix",
    "lint:prettier": "prettier --check src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "lint:prettier-fix": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "lint:types": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "browserux.css": "5.0.1",
    "clsx": "2.1.1",
    "es-toolkit": "1.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@markuplint/jsx-parser": "5.3.0",
    "@markuplint/react-spec": "5.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "browserslist": "4.29.4",
    "browserslist-lint": "0.4.0",
    "commitlint": "21.2.4",
    "esbuild": "0.28.2",
    "eslint-plugin-perfectionist": "5.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markuplint": "5.3.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-alphabetical-order": "2.0.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "stylelint-order": "8.1.2",
    "stylelint-plugin-defensive-css": "2.9.7",
    "stylelint-selector-bem-pattern": "5.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-axe": "0.1.0"
  }
}
